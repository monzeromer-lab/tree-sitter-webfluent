// md-docs/recipes/sign-in-with-a-session-cookie.md
type User { id: String, name: String }
type Credentials { email: String, password: String }
/// Why signing in can be refused.
enum SignInError {
    unauthorized(problem: Problem) on 401
    http(error: HttpError)
}
api Auth(base: "/api") {
    credentials: .sameOrigin
    get me at "me" -> User!
    post signIn(body: Credentials) at "signIn" -> User ! SignInError
    post signOut at "signOut" -> !
}
store Session {
    state user: User? = null
    state checked = false
    derived signedIn = user != null
    action load() {
        match await Auth.me() {
            .ok(u) { user = u }
            .err(_) { user = null }
        }
        checked = true
    }
    action signIn(email: String, password: String) -> ! SignInError {
        user = try await Auth.signIn(body: Credentials(email: email, password: password))
        navigate("/account")
    }
    action signOut() -> ! {
        try await Auth.signOut()
        user = null
        Auth.me.invalidate()
        navigate("/")
    }
}
page SignIn(path: "/sign-in", title: "Sign in", description: "Sign in to your account.", noindex: true) {
    state email = ""
    state password = ""
    state problem = ""
    validate email { required  email }
    validate password { required }
    action send() {
        problem = ""
        match await Session.signIn(email, password) {
            .ok { }
            .err(.unauthorized(_)) { problem = "That email and password do not match." }
            .err(.http(e)) { problem = e.message }
        }
    }
    Heading("Sign in").h1
    if problem != "" { Alert(problem).danger }
    Form(bind: form) {
        on submit { send() }
        Input(bind: email, label: "Email").email
        Input(bind: password, label: "Password").password
        Button("Sign in", type: .submit, disabled: send.pending).primary
    }
}
page Account(path: "/account", title: "Your account", description: "Your account.", guard: !Session.checked || Session.signedIn, redirect: "/sign-in") {
    use Session
    // The guard is read when the route opens, which on a reload is before
    // `load` has answered; this sends the reader on once it has.
    effect { if Session.checked && !Session.signedIn { navigate("/sign-in") } }
    Heading("Your account").h1
    if !Session.checked { Spinner }
    if let u = Session.user {
        Text("Signed in as {u.name}")
        Button("Sign out") { on click { Session.signOut() } }
    }
}

// md-docs/recipes/sign-in-with-a-session-cookie.md
app {
    use Session
    Session.load()
    Router
}

