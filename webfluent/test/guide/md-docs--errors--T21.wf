// md-docs/errors/T21.md
type User { name: String }
page P(path: "/", title: "T", description: "D") {
    resource users: [User] = http.get("/api/users")
    Heading("Users").h1
    match users {
        loading { Spinner }
        error(e) { Alert(e.message).danger }
        ready(list) { Text("{list.length} users") }
    }
}

