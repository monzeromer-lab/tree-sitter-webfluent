// AGENTS.md
page Doc(path: "/") {
    resource users = Backend.users(page: n, cache: .swr(60.seconds), refresh: .onFocus)

    match users {
        .loading { Skeleton }
        .failed(e) {
            match e {
                .offline { Alert("You are offline.").warning }
                .timeout { Alert("The server took too long.").warning }
                else     { Alert(e.message).danger }
            }
            Button("Try again") { on click { users.reload() } }
        }
        .loaded(list) { for u in list by u.id { Text(u.name) } }
    }
}

// AGENTS.md
type Post { id: String, title: String }
type FeedPage { posts: [Post], nextCursor: String? }
type LogLine { at: String, text: String }
api Social(base: "/api") {
    get feed(after: String?) at "feed" -> FeedPage!
        pages .cursor(param: after, next: p => p.nextCursor, items: p => p.posts)
    get list(page: Number = 1) at "posts" -> [Post]!
        pages .number(param: page)                // ends at the first empty page
    get search(q: String) at "search" -> [Post]!
        pages .link                               // the Link header's rel="next" (RFC 8288)
    get tail(id: String) at "logs/{id}" -> [LogLine]! streamed
}
store Logs {
    state seen: [String] = []
    action follow(id: String) {
        for await line, i in Social.tail(id: id) { seen = seen.concat(["{i}: {line.text}"]) }
    }
}
page Feed(path: "/feed", title: "Feed", description: "What is new.") {
    resource feed = Social.feed()                 // a paged read of Post
    resource tail = Social.tail(id: "deploy-7")   // .loaded from the first line
    Heading("Feed").h1
    for p in feed.items by p.id { Text(p.title) }
    if feed.hasMore { Button("More", loading: feed.pending) { on click { feed.loadMore() } } }
    Text("{tail.value?.length ?? 0} lines so far")
}

// AGENTS.md
page Doc(path: "/") {
    socket chat = ws("wss://example.com/chat", protocols: ["v2"], heartbeat: 20.seconds) {
        send    Outgoing                  // typed both ways
        receive Incoming
        on message(m) { Feed.add(m) }
    }

    match chat {
        connecting { Spinner.sm }
        open       { for m in chat.messages by m.id { Bubble(m) } }
        closed(c)  { Alert("Disconnected ({c.code})").warning }
        error(e)   { Alert(e.message).danger }
    }
    Button("Send") { on click { chat.send(Outgoing(text: draft))  draft = "" } }

    stream ticks = sse("/events", events: ["price", "status"])
    effect { if let p = ticks.last("price") { price = p } }

    channel cart = broadcast("cart") { on message(m) { Cart.merge(m) } }
    Button("Sync") { on click { cart.post({ items: Cart.count }) } }

    beacon("/analytics", { event: "checkout", value: total })   // survives unload
}

// AGENTS.md
type Problem { line: Number, message: String }
type CssMessage { type: String, items: [Problem] = [] }
store Lang {
    state problems: [Problem] = []
    worker css = spawn("/workers/css.js", restart: 1, timeout: 5000) {
        receive CssMessage
        on message(m) { if m.type == "diagnostics" { problems = m.items } }
        on restart(e) { log("css restarted: {e.message}") }
    }
    action complete(text: String, at: Number) -> Json {
        return await css.request("complete", { text: text, at: at }, { supersede: true })
    }
}

