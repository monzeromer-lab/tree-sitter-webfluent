page Gallery(path: "/gallery", title: "Gallery", description: "Cards that lean.") {
    state max = 15
    Heading("Gallery").h1
    Card(class: "tilt",
         mount: (n) => initTilt(n, max),      // each time the element is made
         update: (tilt) => tilt.setMax(max),  // again when what it reads changes
         cleanup: (tilt) => tilt.destroy()) { // when its page, branch or item leaves
        Text("Lean on me.")
    }
}

// AGENTS.md
page Doc(path: "/") {
    for row, i in Completions.rows by i {
        Portal(into: editorHost(row.id), data-popup: "row") {   // a node CodeMirror made
            Text(row.label) {
                on mousedown(e) { e.preventDefault() }          // the editor keeps the focus
                on click { Completions.pick(i) }
            }
        }
    }
}

