type Deploy { id: String, service: String, status: String }
store Deploys {
    state items: [Deploy] = []
    derived live = items.filter(d => d.status == "live").length
}
page Live(path: "/live", title: "Live") {
    use Deploys
    Text("{Deploys.live} live")
}

