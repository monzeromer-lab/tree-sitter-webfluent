store Prefs { persist scheme = "light" }
page Theme(path: "/theme", title: "Theme") {
    use Prefs
    Button("Switch theme") {
        on click { Prefs.scheme = if Prefs.scheme == "light" { "dark" } else { "light" } }
    }
