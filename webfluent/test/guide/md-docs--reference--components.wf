        Dropdown.Item { Button("Duplicate") { on click { said = "Duplicated" } } }
        Dropdown.Item { Button("Rename") { on click { said = "Renamed" } } }
        Dropdown.Divider
        Dropdown.Item { Button("Archive").danger { on click { said = "Archived" } } }
    }
    Text(said).muted
}

