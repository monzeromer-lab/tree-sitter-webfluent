page Doc(path: "/") {
    Lightbox(label: "Launch week", previous: "Previous photo", next: "Next photo", close: "Close", zoom: "Zoom", of: "of") {
        Gallery(columns: 3, ratio: 4 / 3) {
            Image(src: "/og.png", alt: "The launch card, as it was shared")
