// md-docs/recipes/keyframes.md
animation Pulse {
    from { opacity: 1 }
    50% { opacity: 0.4; transform: scale(0.98) }
    to { opacity: 1 }
}
animation Drop {
    from { transform: translateY(-12px); opacity: 0 }
    to { transform: none; opacity: 1 }
}
page Custom(path: "/", title: "Custom", description: "Keyframes of your own.") {
    state saving = false
    Heading("Custom").h1
    Card(animate: .Drop) {
        Button("Save") { on click { saving = !saving } }
        if saving { Badge("Saving", animate: .Pulse).info }
    }
}

// md-docs/recipes/keyframes.md
animation Pulse {
    from { opacity: 1 }
    50% { opacity: 0.4 }
    to { opacity: 1 }
}
page Live(path: "/", title: "Live", description: "A badge that pulses for as long as it is shown.") {
    Heading("Live").h1
    Badge("Recording") {
        style {
            @media (prefers-reduced-motion: no-preference) {
                animation: Pulse 1s infinite
            }
        }
    }
}

