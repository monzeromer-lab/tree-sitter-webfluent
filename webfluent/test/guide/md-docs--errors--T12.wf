// md-docs/errors/T12.md
type Session { token: Secret }
api Auth(base: "/api") {
    post signIn(body: Session) at "session" -> !
}
page P(path: "/", title: "T", description: "D") {
    state token: Secret = ""
    Heading("Token").h1
    Button("Sign in") { on click { Auth.signIn(body: Session(token: token)) } }
}

