    Card(mount: (n) => initTilt(n, 10)) { Text("Pro") }
    Element("stripe-pricing-table", publishableKey: STRIPE_KEY)
}
page Doc(path: "/") {
    // Your publishable key, from the Stripe dashboard.
}

